--- !u!114 &8454843513045356466
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4011135094259135054}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f794b731368b776409a16c75a90ba2d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nameText: {fileID: 1055040380700690018}
  dialogueText: {fileID: 7550591198506599968}
  typewriter: {fileID: 4999269127366099627}
  UIPosition: 0
  dialogueLines:
  - Name: Aster
    text: "\u2026\xBFD\xF3nde\u2026 estoy?\nEl sonido del mar\u2026 y la arena caliente\u2026"
  - Name: Sym
    text: "Ey, ey\u2026 tranquila, est\xE1s a salvo.\nTe vi caer desde esa luz, pens\xE9
      que no despertar\xEDas."
  - Name: Aester
    text: "\xBFQui\xE9n eres t\xFA?\nY\u2026 \xBFqu\xE9 pas\xF3 con ese destello?"
  - Name: Sym
    text: "Me llamo Sym.\nNo tengo ni idea de qu\xE9 fue esa luz, pero casi me deja
      ciega."
  - Name: Sym
    text: "Vamos, intenta levantarte.\nTe dar\xE9 la mano, no parece que puedas hacerlo
      sola."
  - Name: Aester
    text: "\u2026"
